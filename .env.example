# Server
SERVER_PORT=8080
SERVER_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geo_alert
DB_USER=geo_alert
DB_PASSWORD=secret
DB_MAX_CONNECTIONS=20

# Auth
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_EXPIRY_HOURS=24

# Firebase (Storage + FCM)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Workers
TTL_WORKER_INTERVAL_MINUTES=5
FCM_CLEANUP_INTERVAL_HOURS=6

# Rate Limiting
RATE_LIMIT_MARKERS_PER_HOUR=20
RATE_LIMIT_LIKES_PER_HOUR=100
RATE_LIMIT_COMMENTS_PER_HOUR=50
RATE_LIMIT_GLOBAL_PER_HOUR=1000
